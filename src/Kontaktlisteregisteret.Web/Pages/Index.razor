@page "/"
@inject VirksomhetService VirksomhetSvc
@inject NavigationManager Nav

<PageTitle>Kontaktlisteregisteret</PageTitle>

<div class="page-header">
    <h1>Velg virksomhet</h1>
    <a href="admin/virksomheter" class="btn btn-sm">⚙ Administrer virksomheter</a>
</div>

<p style="color:var(--text-muted);margin-bottom:1.5rem">
    Velg hvilken virksomhet du vil jobbe i. Alle adresselister, målgrupper og abonnementslister
    er isolert per virksomhet.
</p>

@if (loading)
{
    <div class="loading">Laster...</div>
}
else if (!virksomheter.Any())
{
    <div class="empty-state">
        <p>Ingen virksomheter er registrert ennå.</p>
        <a href="admin/virksomheter" class="btn btn-primary" style="margin-top:12px">
            Registrer første virksomhet
        </a>
    </div>
}
else
{
    <div class="card">
        @foreach (var v in virksomheter)
        {
            var url = $"{v.Orgnr}/adresselister";
            <div class="card-row" @onclick="() => Nav.NavigateTo(url)" style="cursor:pointer">
                <div class="grow">
                    <div class="row-name">@v.Navn</div>
                    <div class="row-sub">
                        Orgnr: <span style="font-family:monospace">@v.Orgnr</span>
                        · Onboardet @v.OnboardetAt.ToString("dd. MMM yyyy")
                        @if (!string.IsNullOrEmpty(v.OnboardetAv))
                        { <text> av @v.OnboardetAv</text> }
                    </div>
                </div>
                <span class="tag @(v.Status == VirksomhetStatus.Aktiv ? "tag-dynamic" : "tag-error")">
                    @v.Status
                </span>
                <span class="expand-icon">→</span>
            </div>
        }
    </div>
}

@code {
    List<Virksomhet> virksomheter = [];
    bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        virksomheter = await VirksomhetSvc.GetAllAsync();
        loading = false;
    }
}

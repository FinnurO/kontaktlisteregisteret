@page "/{Orgnr}/adresselister/ny"
@inject AdresselisteService Svc
@inject VirksomhetContext Ctx
@inject NavigationManager Nav

<PageTitle>Ny adresseliste — Kontaktlisteregisteret</PageTitle>

@if (Ctx.IsUnknown) { return; }

<div class="page-header">
    <a href="@($"/{Orgnr}/adresselister")" class="btn btn-sm">← Tilbake</a>
    <h1>Ny adresseliste</h1>
</div>

<div class="wizard-card">
    <div class="form-group">
        <label class="form-label">Tittel</label>
        <input class="form-input" @bind="tittel"
            placeholder="F.eks. Høring av NOU 2026:2 Politikk for nye generasjoner" />
    </div>
    <div class="form-group">
        <label class="form-label">Beskrivelse <span class="muted">(valgfri)</span></label>
        <textarea class="form-input" rows="3" @bind="beskrivelse"
            placeholder="Kontekst, frist, avsender..."></textarea>
    </div>

    @if (error is not null)
    {
        <div class="alert-error">@error</div>
    }

    <div style="display:flex;gap:8px;margin-top:8px">
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@saving">
            @(saving ? "Oppretter..." : "Opprett adresseliste")
        </button>
    </div>
</div>

@code {
    [Parameter] public string Orgnr { get; set; } = "";

    string tittel = "", beskrivelse = "";
    string? error;
    bool saving;

    protected override async Task OnParametersSetAsync() =>
        await Ctx.LoadAsync(Orgnr);

    async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(tittel)) { error = "Tittel er påkrevd."; return; }
        if (Ctx.Current is null) return;
        saving = true;
        error = null;
        var besk = beskrivelse.Trim().Length > 0 ? beskrivelse.Trim() : (string?)null;
        var liste = await Svc.CreateAsync(tittel.Trim(), besk, virksomhetId: Ctx.Current.Id);
        Nav.NavigateTo($"/{Orgnr}/adresselister/{liste.Id}");
    }
}

@page "/admin/revisjon"
@inject AuditLogService AuditSvc
@inject AppDbContext Db

<PageTitle>Revisjonslogg — Kontaktlisteregisteret</PageTitle>

<div class="page-header">
    <h1>Revisjonslogg</h1>
</div>

@if (innslag.Any())
{
    <div class="card">
        @foreach (var e in innslag)
        {
            <div class="card-row small">
                <div class="grow">
                    <div class="row-name">@e.Handling @e.EnhetsType — @(e.EnhetsNavn ?? $"#{e.EnhetsId}")</div>
                    <div class="row-sub">@e.Tidspunkt.ToLocalTime().ToString("dd. MMM yyyy HH:mm") · @(e.UtførtAv ?? "System")</div>
                </div>
                <span class="tag">@e.EnhetsType</span>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">Ingen logginnslag ennå.</div>
}

@code {
    List<AuditLog> innslag = [];

    protected override async Task OnInitializedAsync()
    {
        innslag = await Db.AuditLogg
            .OrderByDescending(a => a.Tidspunkt)
            .Take(200)
            .ToListAsync();
    }
}

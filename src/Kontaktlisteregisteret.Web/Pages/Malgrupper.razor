@page "/{Orgnr}/malgrupper"
@inject TargetGroupService Svc
@inject VirksomhetContext Ctx
@inject NavigationManager Nav

<PageTitle>Målgrupper — Kontaktlisteregisteret</PageTitle>

@if (Ctx.IsUnknown) { return; }

<div class="page-header">
    <h1>Målgrupper</h1>
    <a href="@($"/{Orgnr}/malgrupper/ny")" class="btn btn-primary">+ Ny målgruppe</a>
</div>

@if (loading)
{
    <div class="loading">Laster...</div>
}
else if (!groups.Any())
{
    <div class="empty-state">
        <p>Ingen målgrupper er opprettet ennå.</p>
        <a href="@($"/{Orgnr}/malgrupper/ny")" class="btn btn-primary">Opprett din første målgruppe</a>
    </div>
}
else
{
    <div class="card">
        @foreach (var g in groups)
        {
            var url = $"{Orgnr}/malgrupper/{g.Id}";
            <div class="card-row" @onclick="() => Nav.NavigateTo(url)">
                <div class="grow">
                    <div class="row-name">@g.Name</div>
                    <div class="row-sub">
                        @(g.Type == TargetGroupType.Dynamic ? "Dynamisk" : "Statisk") ·
                        @g.Members.Count mottakere ·
                        Opprettet @g.CreatedAt.ToString("dd. MMM yyyy")
                    </div>
                </div>
                <span class="tag @TagClass(g.Type)">@TypeLabel(g.Type)</span>
                <button class="btn btn-sm" @onclick:stopPropagation="true"
                    @onclick="() => KopierAsync(g.Id)">⎘ Kopier</button>
                <button class="btn btn-sm btn-danger" @onclick:stopPropagation="true"
                    @onclick="() => DeleteAsync(g.Id)">Slett</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Orgnr { get; set; } = "";

    List<TargetGroup> groups = [];
    bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await Ctx.LoadAsync(Orgnr);
        if (Ctx.Current is not null)
            groups = await Svc.GetAllAsync(Ctx.Current.Id);
        loading = false;
    }

    async Task KopierAsync(int id)
    {
        var kopi = await Svc.KopierAsync(id);
        Nav.NavigateTo($"/{Orgnr}/malgrupper/{kopi.Id}");
    }

    async Task DeleteAsync(int id)
    {
        await Svc.DeleteAsync(id);
        if (Ctx.Current is not null)
            groups = await Svc.GetAllAsync(Ctx.Current.Id);
    }

    static string TagClass(TargetGroupType t) => t == TargetGroupType.Dynamic ? "tag-dynamic" : "tag-static";
    static string TypeLabel(TargetGroupType t) => t == TargetGroupType.Dynamic ? "Dynamisk" : "Statisk";
}

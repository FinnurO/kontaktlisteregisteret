<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Shared.MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="ex">
                <div style="padding:2rem; text-align:center;">
                    <h2>Noe gikk galt</h2>
                    <p>Det oppstod en uventet feil. Prøv å laste siden på nytt.</p>
                    <a href="/">Gå til forsiden</a>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <PageTitle>Ikke funnet</PageTitle>
        <LayoutView Layout="@typeof(Shared.MainLayout)">
            <p>Siden finnes ikke.</p>
        </LayoutView>
    </NotFound>
</Router>
